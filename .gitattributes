# Normalise line endings: LF in the repository and working tree (shell scripts must stay LF
# for Linux containers); Windows-only scripts keep CRLF.
* text=auto eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
