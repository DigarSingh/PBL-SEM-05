# ShopSmart environment configuration.
DATABASE_URL=jdbc:mysql://localhost:3307/shopsmart?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DATABASE_USERNAME=shopsmart
DATABASE_PASSWORD=change-me-strong-db-password
# Used only by docker compose to initialise the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-strong-root-password

# --- Authentication -----------------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SECRET=replace-with-at-least-32-random-characters
# Access-token lifetime (ISO-8601 or 15m / 1h style).
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# true in production (HTTPS). false only for plain-HTTP local testing.
COOKIE_SECURE=false

# --- Razorpay  --------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you set when creating the webhook in the Razorpay dashboard (not the key secret).
RAZORPAY_WEBHOOK_SECRET=

# --- E-mail (SMTP) ------------------------------------------------------------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@shopsmart.example

# --- AI service ---------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
# Shared secret between backend and AI service (both directions).
AI_SERVICE_API_KEY=replace-with-a-long-random-string
# The model is selected at image build and can be changed without code changes.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# auto uses sentence-transformers when baked into the image, otherwise TF-IDF.
EMBEDDING_BACKEND=auto
AI_REFRESH_INTERVAL_SECONDS=120
AI_INTERACTION_DAYS=180
AI_BACKEND_TIMEOUT_SECONDS=10

# --- Frontend / CORS ----------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Development seed data (dev profile only; never used in production) --------
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@shopsmart.test
SEED_ADMIN_PASSWORD=choose-a-dev-admin-password
SEED_CUSTOMER_PASSWORD=choose-a-dev-customer-password
